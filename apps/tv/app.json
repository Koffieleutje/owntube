{
  "expo": {
    "name": "OwnTube",
    "slug": "owntube-tv",
    "version": "0.2.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "platforms": ["android"],
    "android": {
      "package": "com.mdbraber.owntube.tv",
      "icon": "./assets/icon.png",
      "versionCode": 2,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "www.youtube.com"
            },
            {
              "scheme": "https",
              "host": "youtube.com"
            },
            {
              "scheme": "https",
              "host": "m.youtube.com"
            },
            {
              "scheme": "https",
              "host": "music.youtube.com"
            },
            {
              "scheme": "https",
              "host": "youtu.be"
            },
            {
              "scheme": "http",
              "host": "www.youtube.com"
            },
            {
              "scheme": "http",
              "host": "youtube.com"
            },
            {
              "scheme": "http",
              "host": "youtu.be"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/banner.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-speech-recognition",
      "./plugins/with-tv-search",
      "./plugins/with-media-keys",
      "./plugins/with-release-signing",
      "./plugins/with-image-memory"
    ],
    "extra": {
      "owntubeUrl": "http://10.0.2.2:3000"
    },
    "icon": "./assets/icon.png",
    "scheme": "owntube"
  }
}
