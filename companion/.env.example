# Shared secret the LAN OwnTube publisher sends as `Authorization: Bearer …`.
# Must match OWNTUBE_PUBLISH_SECRET on the home side. Generate: openssl rand -hex 32
PUBLISH_SECRET=change-me

# HTTP Basic Auth for the /rss feeds + index. Put these in your podcast app URL:
#   https://RSS_USER:RSS_PASS@owntube.nedworks.org/rss/playlist/<slug>.audio.xml
RSS_USER=owntube
RSS_PASS=change-me

# Optional IP allow-list for /publish (layered on top of PUBLISH_SECRET). Only
# these sources may push feed updates. Leave both blank to disable (Bearer only).
# Client IP is read from X-Forwarded-For (behind Caddy).
#
# Explicit IPs / CIDRs (comma-separated) — the home public v4 + v6 prefix:
PUBLISH_ALLOW_IPS=203.0.113.10,2001:db8:1234::/48
# Or (instead/also) hostnames, re-resolved every ~60s so a DDNS home IP tracks
# changes automatically (avoids editing this on every IP change):
PUBLISH_ALLOW_HOSTS=
